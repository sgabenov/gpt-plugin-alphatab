{
  "name": "gpt-plugin-guitarpro-tab-composer",
  "version": "0.1.0",
  "private": true,
  "files": [
    ".codex-plugin/",
    ".mcp.json",
    "assets/",
    "dist/",
    "docs/",
    "schemas/",
    "scripts/launch-guitarpro-tab-composer-mcp",
    "skills/",
    "vendor/"
  ],
  "type": "module",
  "description": "ChatGPT Plugin for generating, rendering, playing, importing, and exporting music notation with alphaTab.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-alphatab-assets.mjs",
    "schema:generate": "npm run build:server && node scripts/generate-music-score-schema.mjs",
    "schema:check": "node scripts/generate-music-score-schema.mjs --check",
    "build": "npm run build:ui && npm run build:server",
    "build:ui": "node scripts/build-ui.mjs",
    "build:server": "tsc -p tsconfig.server.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server/server.js",
    "start:stdio": "node dist/server/server.js --stdio",
    "test": "vitest run",
    "test:ui": "vitest run test/ui-production.test.ts test/ui-resource.test.ts",
    "lint": "node scripts/lint-repository.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "package:check": "node scripts/package-plugin.mjs --dry-run",
    "package:plugin": "node scripts/package-plugin.mjs",
    "prepack": "npm run build && npm run schema:check && npm run validate:plugin",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run schema:check && npm run validate:plugin"
  },
  "dependencies": {
    "@coderline/alphatab": "1.8.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
