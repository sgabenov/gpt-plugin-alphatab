{
  "mcpServers": {
    "guitarpro-tab-composer": {
      "command": "./scripts/launch-guitarpro-tab-composer-mcp",
      "args": ["--stdio"],
      "cwd": ".",
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "CODEX_BROWSER_USE_NODE_PATH",
        "CODEX_ELECTRON_RESOURCES_PATH",
        "CODEX_CLI_PATH",
        "CODEX_THREAD_ID",
        "CODEX_ARTIFACTS_DIR",
        "GUITARPRO_TAB_DATA_DIR",
        "GUITARPRO_TAB_ARTIFACT_DIR",
        "TMPDIR",
        "XDG_DATA_HOME",
        "XDG_CACHE_HOME",
        "HOME",
        "PATH"
      ]
    }
  }
}
